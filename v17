                <div style="margin-top:6px;"><strong style="color:#e7e7e7;">Courses:</strong> ${courses.map(escapeHtml).join(", ")}</div>
                <div style="margin-top:4px;"><strong style="color:#e7e7e7;">Locations:</strong> ${locs.map(escapeHtml).join(", ")}</div>
              </td>
            </tr>
          `;
        }).join("")}
      </tbody>
    </table>
  `;
  // make rows interactive (click to explore)
  const rows = el.querySelectorAll("tr.clusterRow");
  const topArr = window.__themeClusterTop || [];

  function setSelectedRow(id) {
    __selectedClusterId = id;
    rows.forEach(r => r.classList.toggle("selected", Number(r.dataset.clusterId) === id));
  }

  rows.forEach(r => {
    r.addEventListener("click", () => {
      const id = Number(r.dataset.clusterId);
      const c = topArr.find(x => x._id === id);
      setSelectedRow(id);
      drawClusterExplorer(c);
    });
  });

  if (topArr.length) {
    setSelectedRow(topArr[0]._id);
    drawClusterExplorer(topArr[0]);
  } else {
    drawClusterExplorer(null);
  }

}




// --- export helpers (SVG to PNG) ---
  async function exportSvgToPng(svgEl, fileName) {
    const svg = svgEl.cloneNode(true);

    // ensure explicit size
    const w = svgEl.getAttribute("width") || svgEl.clientWidth;
    const h = svgEl.getAttribute("height") || svgEl.clientHeight;
    svg.setAttribute("width", w);
    svg.setAttribute("height", h);

    const xml = new XMLSerializer().serializeToString(svg);
    const svg64 = btoa(unescape(encodeURIComponent(xml)));
    const image64 = "data:image/svg+xml;base64," + svg64;

    const img = new Image();
    img.src = image64;
    await img.decode();

    const canvas = document.createElement("canvas");
    canvas.width = Number(w);
    canvas.height = Number(h);
    const ctx = canvas.getContext("2d");

    // background fill for dark theme
    ctx.fillStyle = "#0b0c10";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(img, 0, 0);

    const a = document.createElement("a");
    a.download = fileName;
    a.href = canvas.toDataURL("image/png");
    a.click();
  }

  // --- event wiring ---
elFile.addEventListener("change", async (evt) => {
  const files = Array.from(evt.target.files || []);
  if (!files.length) return;

  setEnabled(false);
  setStatus("Loading…");

  try {
    allTasks = [];
    let invalidCount = 0;
    let sheetCount = 0;

    for (const f of files) {
      const data = await f.arrayBuffer();
      const wb = XLSX.read(data, { type: "array", cellDates: true });
      sheetCount += wb.SheetNames.length;

      const tasks = parseWorkbookToTasks(wb, f.name);
      invalidCount += tasks.filter(t => !t.valid).length;
      allTasks.push(...tasks);
    }

    const validCount = allTasks.filter(t => t.valid).length;
    const courses = uniqueSorted(allTasks.filter(t => t.valid).map(t => t.course));

    refreshFilterOptions();
    setEnabled(true);

    setStatus(
      `Loaded files: ${files.length}
Sheets scanned: ${sheetCount}
Courses detected (by sheet name): ${courses.length}
Valid tasks: ${validCount}
Rows needing attention (missing required cells): ${invalidCount}`
    );

    applyFilters();
  } catch (err) {
    console.error(err);
    setStatus(`Error while loading:\n${err && err.message ? err.message : String(err)}`);
    setEnabled(false);
  }
});

  // Load from URLs (e.g. OneDrive direct download links). Links must be accessible and allow CORS.
  if (elBtnLoadUrls && elUrlList) {
    elBtnLoadUrls.addEventListener("click", async (evt) => {
      evt.preventDefault();
      const raw = (elUrlList.value || "").trim();
      if (!raw) { setStatus("Paste one or more direct .xlsx file URLs (one per line)."); return; }

      const urls = raw.split(/\r?\n/).map(s => s.trim()).filter(Boolean);
      if (!urls.length) return;

      setEnabled(false);
      setStatus("Loading from URLs…");

      try {
        allTasks = [];
        let invalidCount = 0;
        let sheetCount = 0;

        for (const url of urls) {
          const res = await fetch(url, { mode: "cors" });
          if (!res.ok) throw new Error(`Fetch failed: ${res.status} ${res.statusText}`);

          const data = await res.arrayBuffer();
          const wb = XLSX.read(data, { type: "array", cellDates: true });
          sheetCount += wb.SheetNames.length;

          const fileName = (url.split("/").pop() || "remote.xlsx").split("?")[0];
          const tasks = parseWorkbookToTasks(wb, fileName);

          invalidCount += tasks.filter(t => !t.valid).length;
          allTasks.push(...tasks);
        }

        refreshFilterOptions();
        setEnabled(true);

        const validCount = allTasks.filter(t => t.valid).length;
        setStatus(
          `Loaded URLs: ${urls.length}\nSheets scanned: ${sheetCount}\nValid tasks: ${validCount}\nRows needing attention: ${invalidCount}`
        );

        applyFilters();
      } catch (err) {
        console.error(err);
        setStatus(
          `Error loading URLs. This is usually due to access controls or browser CORS restrictions on OneDrive links.\n\n${err.message || err}`
        );
        setEnabled(true);
      }
    });
  }


  elApply.addEventListener("click", () => applyFilters());
  elReset.addEventListener("click", () => resetFilters());
  const elClusterWindow = document.getElementById("clusterWindow");
  if (elClusterWindow) elClusterWindow.addEventListener("change", () => drawAll());
  if (elClusterKeyword) elClusterKeyword.addEventListener("change", () => drawAll());
  if (elClusterAlignGlobal) elClusterAlignGlobal.addEventListener("change", () => {
    // re-render explorer if one is selected
    const sel = window.__selectedClusterId;
    const list = window.__themeClusterTop;
    if (sel && Array.isArray(list)) {
      const c = list.find(x => String(x._id) === String(sel));
      if (c) drawClusterExplorer(c);
    }
  });


  elLikemin.addEventListener("change", () => {
    const a = Number(elLikemin.value);
    const b = Number(elLikemax.value);
    if (a > b) elLikemax.value = String(a);
  });

  elLikemax.addEventListener("change", () => {
    const a = Number(elLikemin.value);
    const b = Number(elLikemax.value);
    if (b < a) elLikemin.value = String(b);
  });

  elExportGantt.addEventListener("click", async () => {
    await exportSvgToPng(document.getElementById("gantt"), "gantt.png");
  });

  elExportHeat.addEventListener("click", async () => {
    await exportSvgToPng(document.getElementById("heat"), "severity.png");
  });

})();
