    const add = (t.severityPerDay || 0) * days;

    for (const th of themes) totals.set(th, (totals.get(th) || 0) + add);
  }

  const ranked = Array.from(totals.entries()).sort((a, b) => b[1] - a[1]);
  const topN = 8;
