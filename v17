  for (const t of tasks) {
    const themes = (t.themes && t.themes.length) ? t.themes : [];
    if (!themes.length) continue;

    // only accumulate for top themes to keep chart readable
    const used = themes.filter(th => themesTop.includes(th));
    if (!used.length) continue;

    const s = DateTime.fromISO(t.startISO, { zone: "utc" }).startOf("day");
    const f = DateTime.fromISO(t.finishISO, { zone: "utc" }).startOf("day");
