function renderThemeClusters(tasks) {
  const el = document.getElementById("themeClusters");
  if (!el) return;

  if (!tasks.length) {
    el.innerHTML = `<div class="note">No tasks to analyse (check filters).</div>`;
    return;
  }

  const windowDays = Number(document.getElementById("clusterWindow")?.value || 7);
  const keywordSel = document.getElementById("clusterKeyword")?.value || "__all__";
  const keywordLower = (keywordSel && keywordSel !== "__all__") ? String(keywordSel).trim().toLowerCase() : null;

  // build theme instances across ALL themes (not just top themes)
  const instances = [];
  for (const t of tasks) {
    const themes = Array.isArray(t.themes) ? t.themes : [];
    if (!themes.length) continue;

    const s = DateTime.fromISO(t.startISO, { zone: "utc" }).startOf("day");
    const f = DateTime.fromISO(t.finishISO, { zone: "utc" }).startOf("day");
    if (!s.isValid || !f.isValid) continue;

    const days = Math.max(1, Math.floor(f.diff(s, "days").days) + 1);
    const totalSeverity = (t.severityPerDay || 0) * days;

    for (const th of themes) {
      if (keywordLower && String(th).trim().toLowerCase() !== keywordLower) continue;
      instances.push({
        theme: th,
        course: t.course,
        location: t.location || "—",
        moduleName: t.moduleName,
        type: t.type,
        likelihood: t.likelihood,
        studentsBucket: t.studentsBucket,
        start: s,
        end: f,
        startISO: t.startISO,
        finishISO: t.finishISO,
        taskSeverity: totalSeverity
      });
    }
  }

  if (!instances.length) {
    el.innerHTML = `<div class="note">No themes found in the current filtered data.</div>`;
    return;
  }

  const grouped = d3.group(instances, d => d.theme);

  const clusters = [];
  for (const [theme, items] of grouped) {
    const sorted = items.slice().sort((a, b) => a.start.toMillis() - b.start.toMillis());

    let cur = null;

    for (const it of sorted) {
      if (!cur) {
        cur = {
          theme,
          start: it.start,
          end: it.end,
          items: [it],
          totalSeverity: it.taskSeverity
        };
        continue;
      }

      const gap = it.start.diff(cur.end, "days").days;

      if (gap <= windowDays) {
        cur.end = (it.end > cur.end) ? it.end : cur.end;
        cur.items.push(it);
        cur.totalSeverity += it.taskSeverity;
      } else {
        clusters.push(cur);
        cur = {
          theme,
          start: it.start,
          end: it.end,
          items: [it],
          totalSeverity: it.taskSeverity
        };
      }
    }

    if (cur) clusters.push(cur);
  }

  // rank across all themes
  clusters.sort((a, b) => b.totalSeverity - a.totalSeverity);

  const top = clusters.slice(0, 12);

// stash + ids for explorer
