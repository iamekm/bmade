  const maxDT = startOfISOWeek(DateTime.fromISO(maxISO, { zone: "utc" }));

  const weeks = [];
  for (let d = minDT; d <= maxDT; d = d.plus({ weeks: 1 })) weeks.push(d.toISODate());

