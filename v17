function buildThemeInstances(tasks, maxThemes = 18) {
  // rank themes by total severity (task-days), then keep top N to keep charts readable
  const themeTotals = new Map();

  for (const t of tasks) {
    const themes = Array.isArray(t.themes) ? t.themes : [];
    if (!themes.length) continue;

    const s = DateTime.fromISO(t.startISO, { zone: "utc" }).startOf("day");
    const f = DateTime.fromISO(t.finishISO, { zone: "utc" }).startOf("day");
    if (!s.isValid || !f.isValid) continue;

    const days = Math.max(1, Math.floor(f.diff(s, "days").days) + 1);
    const taskSeverity = (t.severityPerDay || 0) * days;

    for (const th of themes) {
      themeTotals.set(th, (themeTotals.get(th) || 0) + taskSeverity);
    }
  }

  const topThemes = Array.from(themeTotals.entries())
    .sort((a, b) => b[1] - a[1])
    .slice(0, maxThemes)
    .map(([th]) => th);

  const topSet = new Set(topThemes);

  // explode tasks into instances per theme
  const instances = [];
  for (const t of tasks) {
    const themes = Array.isArray(t.themes) ? t.themes : [];
    if (!themes.length) continue;

    for (const th of themes) {
      if (!topSet.has(th)) continue;
      instances.push({ theme: th, ...t });
    }
  }

  return { instances, topThemes };
}

function drawThemeGantt(tasks) {
  const svg = d3.select("#themeGantt");
  if (svg.empty()) return;

  svg.selectAll("*").remove();

  if (!tasks.length) return;

  const { instances, topThemes } = buildThemeInstances(tasks, 18);
  if (!instances.length || !topThemes.length) return;

  // time domain
  const minISO = d3.min(instances, d => d.startISO);
  const maxISO = d3.max(instances, d => d.finishISO);

  const minDate = DateTime.fromISO(minISO, { zone: "utc" }).toJSDate();
  const maxDate = DateTime.fromISO(maxISO, { zone: "utc" }).plus({ days: 1 }).toJSDate();

  const width = 1400;
  const rowH = 22;
  const height = Math.max(360, 90 + topThemes.length * rowH);

  svg.attr("width", width).attr("height", height);

  const margin = { top: 26, right: 16, bottom: 30, left: 220 };
  const innerW = width - margin.left - margin.right;
  const innerH = height - margin.top - margin.bottom;

  const x = d3.scaleTime().domain([minDate, maxDate]).range([0, innerW]);
  const y = d3.scaleBand().domain(topThemes).range([0, innerH]).paddingInner(0.18);

  const g = svg.append("g").attr("transform", `translate(${margin.left},${margin.top})`);

  // grid
  g.append("g")
    .attr("class", "grid")
    .attr("transform", `translate(0,${innerH})`)
    .call(d3.axisBottom(x).ticks(d3.timeWeek.every(1)).tickSize(-innerH).tickFormat(() => ""));

  const xAxis = d3.axisBottom(x).ticks(d3.timeWeek.every(1)).tickFormat(d3.timeFormat("%d %b"));
  const yAxis = d3.axisLeft(y).tickSize(0);

  g.append("g")
    .attr("class", "axis")
    .attr("transform", `translate(0,${innerH})`)
    .call(xAxis);

  g.append("g")
    .attr("class", "axis")
    .call(yAxis);

  // simple lane stacking within each theme (so overlaps are readable)
  // We compute a small "subrow" index for overlapping bars in each theme row.
  const byTheme = d3.group(instances, d => d.theme);

  const stacked = [];
  for (const [theme, items] of byTheme) {
    const sorted = items.slice().sort((a, b) => a.startISO.localeCompare(b.startISO));
    const lanesEnd = []; // JSDate end per sublane

    for (const it of sorted) {
      const s = DateTime.fromISO(it.startISO, { zone: "utc" }).toJSDate();
      const e = DateTime.fromISO(it.finishISO, { zone: "utc" }).plus({ days: 1 }).toJSDate();

      let lane = 0;
      while (lane < lanesEnd.length && s < lanesEnd[lane]) lane++;
      if (lane === lanesEnd.length) lanesEnd.push(e);
      else lanesEnd[lane] = e;

      stacked.push({ ...it, _lane: lane, _s: s, _e: e, _laneCount: lanesEnd.length });
    }
  }

  const maxSubLanes = d3.max(stacked, d => d._laneCount) || 1;
  const barH = Math.max(4, Math.floor((y.bandwidth() - 2) / maxSubLanes));

  g.append("g")
    .selectAll("rect")
    .data(stacked)
    .enter()
    .append("rect")
    .attr("class", "task")
    .attr("x", d => x(d._s))
    .attr("y", d => (y(d.theme) || 0) + 1 + d._lane * barH)
    .attr("width", d => Math.max(2, x(d._e) - x(d._s)))
    .attr("height", barH - 1)
    .attr("fill", d => (window.__keywordColour ? window.__keywordColour(d.theme) : likelihoodColour(d.likelihood)))
    .attr("opacity", d => (d.likelihood === 3 ? 0.95 : d.likelihood === 2 ? 0.78 : 0.62))
    .on("mousemove", function(evt, d) { showTooltip(evt, d); })
    .on("mouseleave", hideTooltip);

  svg.append("text")
    .attr("x", margin.left)
    .attr("y", 18)
    .attr("fill", "#aeb6c6")
    .attr("font-size", 12)
    .text("Keyword Gantt: activities duplicated per keyword (top keywords shown).");
}


